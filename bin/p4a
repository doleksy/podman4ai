#!/usr/bin/env bash
# p4a: the podman4ai Launcher. Run under Git Bash on the Host.
set -euo pipefail
shopt -s inherit_errexit

P4A_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$P4A_HOME/lib/common.sh"
# shellcheck source=../lib/podman.sh
source "$P4A_HOME/lib/podman.sh"
# shellcheck source=../lib/hyperv.sh
source "$P4A_HOME/lib/hyperv.sh"
# shellcheck source=../lib/machine.sh
source "$P4A_HOME/lib/machine.sh"
# shellcheck source=../lib/image.sh
source "$P4A_HOME/lib/image.sh"
# shellcheck source=../lib/secret.sh
source "$P4A_HOME/lib/secret.sh"
# shellcheck source=../lib/project.sh
source "$P4A_HOME/lib/project.sh"
# shellcheck source=../lib/allowlist.sh
source "$P4A_HOME/lib/allowlist.sh"
# shellcheck source=../lib/lifecycle.sh
source "$P4A_HOME/lib/lifecycle.sh"

main() {
  local command="${1:-}"
  case $command in
    "" | -h | --help | help) p4a_usage ;;
    machine) shift; p4a_machine "$@" ;;
    image) shift; p4a_image "$@" ;;
    secret) shift; p4a_secret "$@" ;;
    new) shift; p4a_new "$@" ;;
    start) shift; p4a_start "$@" ;;
    stop) shift; p4a_stop "$@" ;;
    shell) shift; p4a_shell "$@" ;;
    claude) shift; p4a_claude "$@" ;;
    recreate) shift; p4a_recreate "$@" ;;
    rm) shift; p4a_rm "$@" ;;
    list) shift; p4a_list "$@" ;;
    status) shift; p4a_status "$@" ;;
    allow) shift; p4a_allow "$@" ;;
    disallow) shift; p4a_disallow "$@" ;;
    blocked) shift; p4a_blocked "$@" ;;
    podman) shift; p4a_sandbox_podman "$@" ;;
    *) p4a_usage_error "unknown command '$command'" "p4a --help" ;;
  esac
}

p4a_usage() {
  cat <<'EOF'
Usage: p4a <command> [args...]

podman4ai Launcher: runs each project's Agents in its own isolated Sandbox.

Commands:
  p4a machine <command>   create, start, stop or check the Sandbox machine
                          (see: p4a machine --help)
  p4a image build         build the Egress proxy and Base images
  p4a secret set agent-token
                          store the Agent token (from 'claude setup-token')
  p4a secret set repo-token <project>
                          store a project's Repo token (a token from GitHub for
                          its one repository); see: p4a secret --help
  p4a new <owner/repo>    create a project: clone a public GitHub repo into
                          its own Sandbox, and start it
  p4a start <project>     start a project's Egress proxy and Sandbox, and
                          check that the Sandbox's network is isolated
  p4a stop <project>      stop a project's Sandbox and Egress proxy
  p4a shell <project> [-- <command>...]
                          open a shell in a project's Sandbox, or run one
                          command there and return its exit code
  p4a claude <project> [<claude argument>...]
                          start a project if it's stopped, then attach to its
                          Claude session (Claude Code in tmux), which keeps
                          running when the terminal closes. If there's none,
                          start one, passing the arguments to Claude Code
  p4a recreate <project>  replace a project's Sandbox and Egress proxy with new
                          ones from the current images and limits, keeping its
                          source and Claude config, and leave it running or
                          stopped as it was
  p4a recreate --all      the same for every project
  p4a rm <project>        remove a project's Sandbox, Egress proxy and network,
                          then ask before deleting its volumes and settings
  p4a list                show every project: running or stopped, its image
                          and the image's age
  p4a status <project>    show one project's state, image and limits
  p4a allow <project> <domain>
                          let a project's Sandbox reach a domain (or
                          *.domain for its subdomains), without a restart
  p4a disallow <project> <domain>
                          take back a domain allowed with p4a allow
  p4a blocked <project>   list the domains a project's Egress proxy refused,
                          most frequent first
  p4a podman <args>...    run any podman command against the Sandbox machine
  p4a --help              show this help
EOF
}

main "$@"

#!/usr/bin/env bash
# Stand-in podman on PATH for the unit tests. See podman.js.
# setup() in test/helpers.bash gives node (a Windows program under Git Bash)
# its paths in a form it understands, so this starts no other process.
exec node "${FAKE_PODMAN_JS:?fake podman: FAKE_PODMAN_JS is not set}" "$@"

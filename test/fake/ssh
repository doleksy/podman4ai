#!/usr/bin/env bash
# Stand-in ssh on PATH for the unit tests.
#
# Records each call to $FAKE_SSH_DIR/calls: its arguments, one per line,
# then "remote:" and the words the remote bash would split the command
# string into, one per line, then a line "--". Exits with $FAKE_SSH_EXIT
# (0 by default).
set -euo pipefail
dir=${FAKE_SSH_DIR:?fake ssh: FAKE_SSH_DIR is not set}
{
  printf '%s\n' "$@"
  echo "remote:"
  eval "words=(${*: -1})"
  # shellcheck disable=SC2154 # set by the eval
  printf '%s\n' "${words[@]}"
  echo "--"
} >> "$dir/calls"
exit "${FAKE_SSH_EXIT:-0}"

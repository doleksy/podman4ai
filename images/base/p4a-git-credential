#!/bin/sh
# git credential helper for https://github.com: signs in with the project's
# Repo token, read from its mounted secret file each time it's needed.
# Configured in the Base image's /etc/gitconfig.
set -eu
# git sends the request on stdin; nothing in it changes the answer.
cat > /dev/null
[ "${1:-}" = get ] || exit 0

secrets="${P4A_SECRETS_DIR:-/run/secrets}"
token=""
[ -r "$secrets/repo-token" ] && token="$(tr -d '[:space:]' < "$secrets/repo-token")"
if [ -z "$token" ]; then
  # The project was created without a Repo token. Say so, and tell git not
  # to prompt for a password instead.
  echo "p4a: this project has no Repo token, so git can't sign in to GitHub." >&2
  echo "  fix: on the Host, run 'p4a secret set repo-token ${P4A_PROJECT:-<project>}', then restart the Sandbox ('p4a stop', then 'p4a start')" >&2
  echo quit=1
  exit 0
fi
printf 'username=x-access-token\npassword=%s\n' "$token"

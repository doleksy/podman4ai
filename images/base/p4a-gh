#!/bin/sh
# gh, signed in to GitHub with the project's Repo token. Installed as
# /usr/local/bin/gh, ahead of the real gh (/usr/bin/gh) on PATH. gh doesn't
# use git's credential helpers, so like p4a-git-credential this reads the
# mounted secret file on each call, and the token is only in this one gh
# process's environment. A GH_TOKEN or GITHUB_TOKEN already set wins.
set -eu
real="${P4A_REAL_GH:-/usr/bin/gh}"
if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  secrets="${P4A_SECRETS_DIR:-/run/secrets}"
  token=""
  [ -r "$secrets/repo-token" ] && token="$(tr -d '[:space:]' < "$secrets/repo-token")"
  if [ -n "$token" ]; then
    GH_TOKEN="$token"
    export GH_TOKEN
  else
    echo "p4a: this project has no Repo token, so gh isn't signed in to GitHub." >&2
    echo "  fix: on the Host, run 'p4a secret set repo-token ${P4A_PROJECT:-<project>}', then restart the Sandbox ('p4a stop', then 'p4a start')" >&2
  fi
  unset token
fi
exec "$real" "$@"

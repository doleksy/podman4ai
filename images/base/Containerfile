# The Base image every Sandbox starts from: Claude Code and everyday dev
# tools, adapted from Anthropic's reference devcontainer Dockerfile, without
# its sudo, zsh and firewall (the Egress proxy takes its place, ADR 0003).
#
# Built only by `p4a image build`, on a network whose only way out is an
# Egress proxy loaded with the build Allowlist (share/build-allowlist). The
# proxy settings arrive as build arguments, which Podman passes to RUN steps
# without storing them in the image. Each tool is the newest release at
# build time; `p4a image build` then labels the image with its build date
# and Claude Code version.
FROM docker.io/library/debian:bookworm-slim

# Latest OS patches, the tools Debian has in a current enough version, and
# the non-root user Agents run as. The Project volume (/workspace) and
# Claude config volume (~/.claude) mount over directories the user owns,
# so Podman gives each new volume to that user.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git less nano jq ripgrep fzf tmux procps unzip \
      python3 python3-pip libatomic1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 --shell /bin/bash agent \
 && mkdir /workspace /home/agent/.claude \
 && chown agent:agent /workspace /home/agent/.claude

# gh, from GitHub's own apt repository (Debian's is years old).
RUN mkdir -p /etc/apt/keyrings \
 && curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Print the tag of OWNER/REPO's latest GitHub release, from where GitHub's
# "latest" page redirects to (so no GitHub API call is needed).
COPY --chmod=755 <<'EOF' /usr/local/sbin/latest-github-release
#!/bin/bash
set -euo pipefail
url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest")"
echo "${url##*/}"
EOF

# Node: the newest LTS release from nodejs.org (Debian's is past its end
# of life), checked against the release's checksums. It needs libatomic1.
# (Without pipefail, a failed download here and below still fails the
# step: what follows gets no version, or sha256sum no checksum.)
RUN arch="$(dpkg --print-architecture | sed s/amd64/x64/)" \
 && version="$(curl -fsSL https://nodejs.org/dist/index.json | jq -r 'map(select(.lts))[0].version')" \
 && file="node-$version-linux-$arch.tar.gz" \
 && cd /tmp \
 && curl -fsSLO "https://nodejs.org/dist/$version/$file" \
 && curl -fsSL "https://nodejs.org/dist/$version/SHASUMS256.txt" | grep " $file\$" | sha256sum -c - \
 && tar -xzf "$file" -C /usr/local --strip-components=1 --no-same-owner \
      --exclude=CHANGELOG.md --exclude=LICENSE --exclude=README.md \
 && rm "$file"

# uv, from its latest GitHub release, checked against the release's checksum.
RUN arch="$(uname -m)" \
 && file="uv-$arch-unknown-linux-gnu.tar.gz" \
 && url="https://github.com/astral-sh/uv/releases/download/$(latest-github-release astral-sh/uv)" \
 && cd /tmp \
 && curl -fsSLO "$url/$file" \
 && curl -fsSL "$url/$file.sha256" | sha256sum -c - \
 && tar -xzf "$file" -C /usr/local/bin --strip-components=1 --no-same-owner \
 && rm "$file"

# Bun, from its latest GitHub release, checked against the release's
# checksums. Like Bun's own installer, the baseline build on CPUs without
# AVX2.
RUN arch="$(dpkg --print-architecture | sed -e s/amd64/x64/ -e s/arm64/aarch64/)" \
 && if [ "$arch" = x64 ] && ! grep -qw avx2 /proc/cpuinfo; then arch=x64-baseline; fi \
 && file="bun-linux-$arch.zip" \
 && url="https://github.com/oven-sh/bun/releases/download/$(latest-github-release oven-sh/bun)" \
 && cd /tmp \
 && curl -fsSLO "$url/$file" \
 && curl -fsSL "$url/SHASUMS256.txt" | grep " $file\$" | sha256sum -c - \
 && unzip -q -j "$file" "bun-linux-$arch/bun" -d /usr/local/bin \
 && ln -s bun /usr/local/bin/bunx \
 && rm "$file"

# git-delta, from its latest GitHub release (Debian bookworm has none),
# as git's pager on a terminal.
RUN version="$(latest-github-release dandavison/delta)" \
 && file="git-delta_${version}_$(dpkg --print-architecture).deb" \
 && cd /tmp \
 && curl -fsSLO "https://github.com/dandavison/delta/releases/download/$version/$file" \
 && dpkg -i "$file" \
 && rm "$file" \
 && git config --system core.pager delta \
 && git config --system interactive.diffFilter 'delta --color-only'

# tmux with the mouse on and the project's name in the status bar.
COPY tmux.conf /etc/tmux.conf

# Signing in (the tokens are mounted at /run/secrets when a Sandbox is
# created, never stored in the image): p4a-session hands the Agent token to
# Claude Code, and git signs in to GitHub, over HTTPS only, with the
# project's Repo token. Claude Code's default commit attribution adds the
# Co-Authored-By line to Agent commits.
COPY --chmod=755 p4a-session p4a-git-credential /usr/local/bin/
RUN git config --system credential.https://github.com.helper /usr/local/bin/p4a-git-credential

# No sudo, so an Agent can never become root; no zsh; and no firewall
# tooling, since the Egress proxy is the only way out. Fail the build if a
# package ever brings one in.
RUN for tool in sudo zsh iptables ip6tables nft ipset ufw; do \
      if command -v "$tool"; then echo "$tool must not be in the Base image" >&2; exit 1; fi; \
    done

USER agent
WORKDIR /home/agent

# Everything an Agent installs for itself goes in its home, which it owns,
# so no install needs root: npm's global packages (npm install -g),
# uv's tools (uv tool install), Bun's global packages (bun add -g) and
# pip's user packages (pip install --user). Those last land in
# ~/.local/bin and ~/.local/lib; Debian refuses them unless told otherwise,
# which is safe here because the Agent can't write the system's Python.
# The home lives in the Sandbox container, so all of these survive a
# Sandbox restart.
#
# Claude Code's self-updater is off: it updates only when the image is
# rebuilt. Telemetry and error reporting are off too. So is npm's check
# for a newer npm, which also comes with the image.
ENV PATH="/home/agent/.local/bin:/home/agent/.npm-global/bin:/home/agent/.bun/bin:${PATH}" \
    NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    EDITOR=nano \
    VISUAL=nano \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1

# Claude Code via the native installer. Without the non-essential traffic
# setting the installer also calls api.anthropic.com, and it runs
# `npm uninstall -g` to remove any npm install of Claude Code, which
# contacts the npm registry unless npm is offline. Neither domain is on the
# build Allowlist (the calls would be refused, and the install works either
# way).
RUN curl -fsSL https://claude.ai/install.sh \
  | CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 NPM_CONFIG_OFFLINE=true bash

CMD ["bash"]
